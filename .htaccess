DirectoryIndex index.html
Options -Indexes
AddType application/javascript .mjs

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Strict-Transport-Security "max-age=604800"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

<FilesMatch "^(\.env(?:\..*)?|package(-lock)?\.json|README\.md|playwright\.config\.js|indexold\.html|index-legacy\.html)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite(?:-.*)?|db)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)(?:\.runtime|\.env)(?:/|$) - [F,L]
  RewriteCond %{HTTP_HOST} ^www\.mdstrike\.com$ [NC]
  RewriteRule ^ https://mdstrike.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteRule ^(?:app|scripts|tests|\.runtime|node_modules|release)(?:/|$) - [F,L]
  RewriteRule ^enamed/resultados(?:/|$) exam.php [L]
  RewriteRule ^(?:enamed|enare|revalida)(?:/[^/]+)?/?$ exam.php [L]
  RewriteRule ^(?:medicina|consulta-clinica|codificacao-em-saude|exames-medicos|cid-10)(?:/|$) exam.php [L]
  RewriteRule ^sitemap\.xml$ exam.php [L]
</IfModule>
