{
  "name": "mdstrike",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MDSTRIKE_ENV=development MDSTRIKE_DB_DRIVER=sqlite MDSTRIKE_PRIVATE_DIR=.runtime php -S 127.0.0.1:8088 scripts/router.php",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs",
    "vendor:pdf": "node scripts/vendor-pdf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "prettier": "^3.10.1"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  }
}
